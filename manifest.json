{
  "name": "S H I V A M PIXA",
  "short_name": "SHIVAM PIXA",
  "description": "Offline photo editor + collage maker — just like Picasa. Editing, collage, crop, light adjust, text, effects, Sizer photo resizer. Everything stays 100% on your PC, nothing is ever uploaded.",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "share_target": {
    "action": "./",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "photos",
          "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".avif", ".heic", ".heif"]
        }
      ]
    }
  },
  "display": "standalone",
  "orientation": "any",
  "launch_handler": { "client_mode": "focus-existing" },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/jpeg": [".jpg", ".jpeg"],
        "image/png": [".png"],
        "image/webp": [".webp"],
        "image/gif": [".gif"],
        "image/bmp": [".bmp"],
        "image/avif": [".avif"]
      }
    }
  ],
  "background_color": "#0a1c3f",
  "theme_color": "#e8e8e8",
  "lang": "en-IN",
  "categories": ["photo", "utilities"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
