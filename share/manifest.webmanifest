{
  "name": "PIXA SHARE",
  "short_name": "PIXA SHARE",
  "description": "Send phone photos to PIXA on your PC at original quality — same size, same resolution, same ratio. Works over WiFi and mobile data through your own Google Drive.",
  "id": "pixa-share",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef3f9",
  "theme_color": "#0d3b66",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "photos", "accept": ["image/*"] },
        { "name": "files", "accept": ["image/*"] },
        { "name": "image", "accept": ["image/*"] }
      ]
    }
  }
}
